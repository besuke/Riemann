#!/bin/sh
# Finds the core crate `rmql` for the Rust build.
#
# In the repository, src/rust/Cargo.toml points at ../crates/rmql by a relative path, and nothing
# is changed. A source package made by tools/package/build_source_package.R carries the core in
# src/rust/rmql-core, and nothing is changed either. An install by remotes::install_github(...,
# subdir = "crates/rmql-r") builds a package from that folder alone, so the core is missing; then
# the dependency is taken from GitHub at the commit that remotes records in DESCRIPTION (RemoteSha).
# That needs cargo, network access and, on Windows, Rtools; the Windows binary needs none of them.

# On Windows, a build from source needs Rust. Without it, stop here with the way to the binary,
# instead of failing later inside make.
PATH="$USERPROFILE/.cargo/bin:$PATH"
if ! command -v cargo > /dev/null 2>&1; then
  echo "rmql: Rust (cargo) was not found, so this source package cannot be built." >&2
  echo "On Windows, install the binary instead; it needs neither Rust nor Rtools:" >&2
  echo '  install.packages("rmql",' >&2
  echo '                   repos = c("https://besuke.github.io/rmql", "https://cloud.r-project.org"))' >&2
  echo "remotes::install_github() always builds from source." >&2
  exit 1
fi

manifest=src/rust/Cargo.toml
relative='rmql = { path = "../../../rmql" }'

if ! grep -qF "$relative" "$manifest"; then
  exit 0
fi
if [ -f ../rmql/Cargo.toml ]; then
  exit 0
fi

sha=$(sed -n 's/^RemoteSha: *//p' DESCRIPTION | tr -d '\r' | head -n 1)
if [ -z "$sha" ]; then
  sha=$(sed -n 's/^GithubSHA1: *//p' DESCRIPTION | tr -d '\r' | head -n 1)
fi
if [ -z "$sha" ]; then
  echo "rmql: the core crate (crates/rmql) is not next to this package, and DESCRIPTION has" >&2
  echo "no RemoteSha to fetch it from GitHub. Install from the repository (R CMD INSTALL crates/rmql-r)," >&2
  echo "from the source package of a release, or use the Windows binary of a release." >&2
  exit 1
fi

echo "rmql: taking the core crate from https://github.com/besuke/rmql at $sha"
sed "s|^rmql = { path = \"../../../rmql\" }|rmql = { git = \"https://github.com/besuke/rmql\", rev = \"$sha\" }|" \
  "$manifest" > "$manifest.tmp" && mv "$manifest.tmp" "$manifest"
grep -q "rev = \"$sha\"" "$manifest" || { echo "rmql: could not rewrite $manifest" >&2; exit 1; }
