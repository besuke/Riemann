TARGET = x86_64-pc-windows-gnu
TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libriemann_r.a
PKG_LIBS = -L$(LIBDIR) -lriemann_r -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

all: $(SHLIB) cleanup

$(SHLIB): $(STATLIB)

# The Rust standard library for this target asks for libgcc_eh and libgcc_s, which Rtools does
# not provide under those names; empty libraries are enough, as in the extendr template.
# cargo decides what to rebuild; without this, changed Rust sources would keep the old library.
$(STATLIB): FORCE
	mkdir -p $(TARGET_DIR)/libgcc_mock
	cd $(TARGET_DIR)/libgcc_mock && touch gcc_mock.c && gcc -c gcc_mock.c -o gcc_mock.o && ar -r libgcc_eh.a gcc_mock.o && cp libgcc_eh.a libgcc_s.a
	export PATH="$(USERPROFILE)/.cargo/bin:$(PATH)"; \
	export LIBRARY_PATH="$${LIBRARY_PATH};$(CURDIR)/$(TARGET_DIR)/libgcc_mock"; \
	cargo build --target=$(TARGET) --lib --release --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR)

cleanup: $(SHLIB)
	rm -f gcc_mock.c

FORCE:

.PHONY: all cleanup FORCE
